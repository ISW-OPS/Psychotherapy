<mxfile host="app.diagrams.net" agent="ISW" version="24.0.0">
  <diagram name="Flow KOB 6-Stage" id="isw-kob-flow">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="Flow KOB — 6 Stage (status machine kob_status) dari KYC sampai Plan Aktif" style="text;html=1;align=left;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1100" height="32" as="geometry" /></mxCell>

        <!-- LEGEND -->
        <mxCell id="leg1" value="Patient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="950" y="36" width="100" height="26" as="geometry" /></mxCell>
        <mxCell id="leg2" value="Doctor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1060" y="36" width="100" height="26" as="geometry" /></mxCell>
        <mxCell id="leg3" value="Sistem (auto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="950" y="68" width="100" height="26" as="geometry" /></mxCell>
        <mxCell id="leg4" value="Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1060" y="68" width="100" height="26" as="geometry" /></mxCell>
        <mxCell id="leg5" value="&#128293; auto &#183; &#9940; berhenti tunggu &#183; kob_status di setiap kotak" style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="950" y="100" width="300" height="18" as="geometry" /></mxCell>

        <!-- STAGE 1 -->
        <mxCell id="S1" value="Stage 1 &#8212; KYC &#10003;&#10;kob_status: paid &#8594; kyc_done&#10;(lihat Flow_KYC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="90" width="320" height="60" as="geometry" /></mxCell>

        <!-- STAGE 2 -->
        <mxCell id="S2" value="Stage 2 &#8212; Tempah Slot KOB (Patient)&#10;pilih mod F2F/Online + tarikh (block Isnin &amp; Selasa + cuti klinik) + slot waktu&#10;&#8594; INSERT psy_kob_sessions (booked) &#183; kob_status = booked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="180" width="360" height="86" as="geometry" /></mxCell>
        <mxCell id="RESCH" value="Reschedule slot&#10;(sebelum hadir)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1"><mxGeometry x="850" y="195" width="200" height="56" as="geometry" /></mxCell>

        <!-- STAGE 3 -->
        <mxCell id="S3" value="Stage 3 &#8212; Hadir (Doctor)&#10;kob-detail.html tekan &#8220;Hadir&#8221; &#8594; status = hadir &#183; kob_status = hadir&#10;isi Questionnaire + Vitals + Nota SOAP (sulit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="306" width="360" height="86" as="geometry" /></mxCell>

        <!-- STAGE 4 -->
        <mxCell id="S4" value="Stage 4 &#8212; Cadang Pakej (Doctor)&#10;recommended_package_* &#183; kob_status = package_recommended" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="432" width="360" height="60" as="geometry" /></mxCell>
        <mxCell id="DEC" value="Patient beli&#10;pakej?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="530" y="532" width="140" height="90" as="geometry" /></mxCell>
        <mxCell id="DS" value="Simpan rekod&#10;(kekal package_recommended)&#10;&#8212; tiada pakej aktif lagi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="850" y="535" width="220" height="70" as="geometry" /></mxCell>

        <mxCell id="PAY" value="Patient: Bayar Pakej&#10;&#8594; package_payment_status = paid &#183; kob_status = package_paid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="660" width="360" height="60" as="geometry" /></mxCell>

        <!-- STAGE 5 -->
        <mxCell id="S5" value="Stage 5 &#8212; Sign Agreement (Patient)&#10;baca clauses &#8594; lukis signature &#8594; upload PNG + jana signed PDF&#10;&#8594; INSERT psy_kob_agreements &#183; &#9940; BERHENTI &#8212; tunggu doktor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="760" width="360" height="86" as="geometry" /></mxCell>

        <!-- STAGE 6 -->
        <mxCell id="S6" value="Stage 6 &#8212; Tandakan Selesai (Doctor)&#10;status = completed &#183; kob_status = completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="886" width="360" height="60" as="geometry" /></mxCell>
        <mxCell id="AUTO" value="&#128293; Aktifkan Pakej + INSERT psy_package_purchases&#10;+ AUTO-CIPTA psy_treatment_plans &#8594; redirect plan.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="415" y="986" width="370" height="70" as="geometry" /></mxCell>
        <mxCell id="END" value="&#8594; Flow Rawatan" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="1090" width="180" height="46" as="geometry" /></mxCell>

        <!-- EDGES -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="S1" target="S2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="boleh reschedule" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="S2" target="RESCH"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="slot baru" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="RESCH" target="S2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="patient hadir sesi" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="S2" target="S3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="S3" target="S4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="S4" target="DEC"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="DEC" target="DS"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="datang balik &#8594; bayar" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="DS" target="PAY"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="Ya" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="DEC" target="PAY"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="PAY" target="S5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="agreement siap" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="S5" target="S6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="S6" target="AUTO"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="AUTO" target="END"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
