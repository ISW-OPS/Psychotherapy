        <mxCell id="e7" value="Terima (sahkan)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="DEC" target="REC"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="Tolak" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="DEC" target="RJ"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="REC" target="N8"><mxGeometry relative="1" as="geometry" /></mxCell>
