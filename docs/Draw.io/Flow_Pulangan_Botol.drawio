<mxfile host="app.diagrams.net" agent="ISW" version="24.0.0">
  <diagram name="Flow Pulangan Botol" id="isw-pulangan-flow">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="Flow Pulangan Botol Madu — dari Mohon sampai Verify (Terima/Tolak)" style="text;html=1;align=left;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="32" as="geometry" /></mxCell>

        <!-- LEGEND -->
        <mxCell id="leg1" value="Patient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="900" y="40" width="100" height="26" as="geometry" /></mxCell>
        <mxCell id="leg2" value="Staff / Coach" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1010" y="40" width="110" height="26" as="geometry" /></mxCell>
        <mxCell id="leg3" value="Sistem (auto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="900" y="72" width="100" height="26" as="geometry" /></mxCell>
        <mxCell id="leg4" value="Tolak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1010" y="72" width="110" height="26" as="geometry" /></mxCell>
        <mxCell id="leg5" value="&#128276; notifikasi" style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="900" y="104" width="160" height="18" as="geometry" /></mxCell>

        <!-- PATIENT REQUEST -->
        <mxCell id="N1" value="Patient: Buka pulangan.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="460" y="80" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="N2" value="Tick 4 Syarat (semua wajib):&#10;1. Tidak berkarat &#183; 2. Bersihkan dulu&#10;3. Getah masih ada &#183; 4. Besi penutup tak longgar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="160" width="280" height="74" as="geometry" /></mxCell>
        <mxCell id="N3" value="Isi Kuantiti (&#8805;1) + Upload Foto Bukti (&#8805;1, multiple)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="450" y="264" width="260" height="56" as="geometry" /></mxCell>
        <mxCell id="N4" value="Submit&#10;(butang aktif bila semua syarat + foto + qty ok)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="450" y="350" width="260" height="56" as="geometry" /></mxCell>
        <mxCell id="N5" value="Upload foto &#8594; storage &#183; INSERT psy_bottle_returns&#10;(status = pending)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="436" width="280" height="56" as="geometry" /></mxCell>

        <!-- STAFF VERIFY -->
        <mxCell id="N7" value="Staff / Coach: pulangan.html&#10;Review (tengok foto + criteria_confirmed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="450" y="532" width="260" height="56" as="geometry" /></mxCell>
        <mxCell id="DEC" value="Verify?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="510" y="628" width="140" height="90" as="geometry" /></mxCell>

        <!-- TOLAK (kanan) -->
        <mxCell id="RJ" value="Prompt Alasan (wajib)&#10;&#8594; status = rejected + reject_reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="790" y="638" width="260" height="70" as="geometry" /></mxCell>

        <!-- TERIMA -->
        <mxCell id="REC" value="Sahkan diterima &amp; penuhi syarat&#10;&#8594; status = received (verified_by, verified_at)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="760" width="280" height="60" as="geometry" /></mxCell>

        <!-- NOTIFY + STATUS -->
        <mxCell id="N8" value="&#128276; Notify Patient (mesej pulangan botol)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="450" y="860" width="260" height="50" as="geometry" /></mxCell>
        <mxCell id="N9" value="Patient nampak status:&#10;&#9989; Diterima / &#10060; Ditolak: alasan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="450" y="950" width="260" height="56" as="geometry" /></mxCell>
        <mxCell id="END" value="Selesai &#10003;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="1050" width="160" height="46" as="geometry" /></mxCell>

        <!-- EDGES -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="N1" target="N2"><mxGeometry relative="1" as="geometry" /></mxCell>
