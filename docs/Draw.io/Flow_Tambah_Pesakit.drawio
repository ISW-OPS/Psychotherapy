        <mxCell id="banner" value="FLOW: TAMBAH PESAKIT (STAFF)&#10;Aliran penuh dari tambah pesakit sehingga rekod dan plan diwujudkan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2d4d;strokeColor=none;fontColor=#ffffff;fontSize=18;fontStyle=1;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1170" height="70" as="geometry" /></mxCell>

