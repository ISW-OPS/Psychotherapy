        <mxCell id="note1" value="&#8226; BAYARAN MASIH SIMULASI &#8212; sentiasa 'berjaya' selepas 1200ms&#10;&#8226; Gateway sebenar (FPX / Kad) BELUM disambung (Billplz / ToyyibPay pending)&#10;&#8226; SST dan caj servis = 0 (buat masa ini)&#10;&#8226; DB writes SEBENAR (orders, payments, purchases, stok)&#10;&#8226; Staff: payment-admin.html untuk rekod manual + invois + eksport" style="text;html=1;align=left;fontSize=11;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="784" y="378" width="412" height="252" as="geometry" /></mxCell>

