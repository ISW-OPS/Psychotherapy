        <mxCell id="n2" value="&#128293; Kumpul semua tertunggak: shop order + pakej&#10;(pending_payment) + extension + temu janji + KOB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="195" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="n3" value="Pesakit pilih kaedah: FPX / Kad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="280" width="320" height="45" as="geometry" /></mxCell>

        <mxCell id="d1" value="Pakej sudah aktif?&#10;(race guard)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="350" width="200" height="90" as="geometry" /></mxCell>
