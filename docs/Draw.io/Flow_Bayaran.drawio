        <mxCell id="r2" value="&#9888; AMARAN: processPayment() = SIMULASI sahaja&#10;(delay 1200ms). TIADA gateway sebenar.&#10;Pending Billplz / ToyyibPay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="465" width="320" height="70" as="geometry" /></mxCell>
        <mxCell id="n6" value="&#128293; Proses ikut jenis: pakej &#8594; psy_package_purchases&#10;aktif + jana pelan; order &#8594; psy_orders + tolak stok;&#10;KOB &#8594; kob_status; extension &#8594; extension_paid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="560" width="320" height="75" as="geometry" /></mxCell>
        <mxCell id="n7" value="&#128293; INSERT psy_payments (receipt_ref, items, total,&#10;status=completed). Audit + notify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="660" width="320" height="60" as="geometry" /></mxCell>
