        <mxCell id="note1" value="&#8226; Event Reminder = LIVE (testing). Catatan Harian / Birthday / Manzil = DRAFT&#10;&#8226; Kepatuhan Alert = ready (is_active=false)&#10;&#8226; 5 jenis trigger; semua live-config tanpa re-deploy&#10;&#8226; Dedup: reminder_sent_at / last_broadcast_at&#10;&#8226; Hantar via GHL (GoHighLevel) API&#10;&#8226; Deploy prod masih pending" style="text;html=1;align=left;fontSize=11;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="784" y="378" width="412" height="242" as="geometry" /></mxCell>

