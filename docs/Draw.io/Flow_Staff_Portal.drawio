<mxfile host="app.diagrams.net" agent="ISW" version="24.0.0">
  <diagram name="Flow Staff Portal" id="isw-staff-flow">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="t" value="Flow Bahagian Staff — Login &#8594; RBAC &#8594; Dashboard &#8594; Tugas ikut Role" style="text;html=1;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="900" height="30" as="geometry" /></mxCell>
        <mxCell id="lg" value="Admin=biru &#183; Doctor=oren &#183; Coach=kuning &#183; Manager=hijau &#183; Super Admin=merah &#183; Sistem=hijau muda" style="text;html=1;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="760" height="18" as="geometry" /></mxCell>

        <!-- ENTRY CHAIN -->
        <mxCell id="L1" value="Staff: Login (auth/login.html)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="60" width="280" height="44" as="geometry" /></mxCell>
        <mxCell id="L2" value="checkAuth() &#8594; profile (role = staff &#183; staff_role)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="450" y="124" width="320" height="44" as="geometry" /></mxCell>
        <mxCell id="L3" value="loadPermissions() &#8592; psy_user_effective_permissions&#10;(cache module &#215; action)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="188" width="340" height="56" as="geometry" /></mxCell>
        <mxCell id="L4" value="Navbar dibina ikut RBAC&#10;(can(module,action) &#183; super_admin nampak semua)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="264" width="340" height="56" as="geometry" /></mxCell>
        <mxCell id="L5" value="Dashboard (KPI ikut role)&#10;&#8212; per-page guard di _shared.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="340" width="280" height="50" as="geometry" /></mxCell>

        <!-- ROLE CLUSTERS -->
        <mxCell id="ADMIN" value="ADMIN&#10;&#8226; Pesakit &amp; KYC  (&#8594; Flow_KYC)&#10;&#8226; Pakej &#183; Produk&#10;&#8226; Inventori  (&#8594; Flow_Inventori)&#10;&#8226; Slot &amp; Cuti Klinik&#10;&#8226; Surat  (&#8594; Flow_Surat)&#10;&#8226; Pengumuman &#183; Library&#10;&#8226; Orders  (&#8594; Flow_Shop_Order)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="230" height="200" as="geometry" /></mxCell>
        <mxCell id="DOCTOR" value="DOCTOR&#10;&#8226; KOB Sessions  (&#8594; Flow_KOB)&#10;&#8226; Tanda Hadir&#10;&#8226; Questionnaire &#183; Vitals&#10;&#8226; Nota SOAP (sulit)&#10;&#8226; Cadang Pakej &#183; Selesai&#10;&#8226; Laporan Perubatan" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="470" width="230" height="200" as="geometry" /></mxCell>
        <mxCell id="COACH" value="COACH&#10;&#8226; Caseload &#183; Patient Hub&#10;&#8226; Weekly Plan &#183; Nota + Skor&#10;&#8226; Kepatuhan  (&#8594; Flow_Kepatuhan_Rawatan)&#10;&#8226; Vitals&#10;&#8226; Pulangan Botol  (&#8594; Flow_Pulangan_Botol)&#10;&#8226; Request Inventori" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="470" width="240" height="200" as="geometry" /></mxCell>
        <mxCell id="MANAGER" value="MANAGER&#10;&#8226; Lulus Permohonan Inventori&#10;&#8226; Laporan &#183; Governance&#10;&#8226; Payment Admin&#10;&#8226; Proses Orders&#10;&#8226; Closures (Cuti Klinik)&#10;&#8226; Staff Stats" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="470" width="230" height="200" as="geometry" /></mxCell>
        <mxCell id="SUPER" value="SUPER ADMIN&#10;&#8226; Urus Staf (staff_management)&#10;&#8226; Peranan / RBAC (peranan.html)&#10;&#8226; Audit Kebenaran&#10;&#8226; AKSES PENUH semua modul&#10;&#8482; bypass semua RBAC" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="470" width="230" height="200" as="geometry" /></mxCell>

        <!-- NOTE -->
        <mxCell id="note" value="Setiap modul/tindakan ditapis RBAC: can(module, action). Jika tiada kebenaran &#8594; item navbar disembunyikan + halaman blok (redirect dashboard). super_admin bypass semua." style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="1000" height="20" as="geometry" /></mxCell>

