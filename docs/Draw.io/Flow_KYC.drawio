<mxfile host="app.diagrams.net" agent="ISW" version="24.0.0">
  <diagram name="Flow KYC" id="isw-kyc-flow">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="Flow KYC — dari Isi Borang sampai Diluluskan (gate akses ke KOB)" style="text;html=1;align=left;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1050" height="32" as="geometry" /></mxCell>

        <!-- LEGEND -->
        <mxCell id="leg1" value="Patient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="950" y="36" width="100" height="26" as="geometry" /></mxCell>
        <mxCell id="leg2" value="Admin / Staff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1060" y="36" width="110" height="26" as="geometry" /></mxCell>
        <mxCell id="leg3" value="Sistem (auto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="950" y="68" width="100" height="26" as="geometry" /></mxCell>
        <mxCell id="leg4" value="Tolak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1060" y="68" width="110" height="26" as="geometry" /></mxCell>
        <mxCell id="leg5" value="&#128293; auto &#183; &#128276; notifikasi &#183; &#128274; gate akses" style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="950" y="100" width="280" height="18" as="geometry" /></mxCell>

        <!-- STAFF-CREATED BRANCH (kiri) -->
        <mxCell id="S1" value="Admin: Tambah Pesakit + isi KYC info&#10;&#8594; psy_kyc_submissions (status = approved,&#10;created_by_staff)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="S2" value="Patient signup (emel sama)&#10;&#8594; autoLink claim &#8594; SKIP KYC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="260" height="60" as="geometry" /></mxCell>

        <!-- PATIENT SELF-FILL -->
        <mxCell id="N1" value="Patient: Dashboard &#8220;Langkah 1/3&#8221;&#10;&#8594; Buka kyc.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="280" height="56" as="geometry" /></mxCell>
        <mxCell id="N2" value="Isi Borang KYC (lengkap):&#10;IC &#183; biodata &#183; telefon/alamat &#183; marital/occupation&#10;waris &#183; masalah kesihatan &#183; insurans (opt)&#10;upload IC + dokumen &#183; consent (data/health/&#8230;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="180" width="320" height="96" as="geometry" /></mxCell>
        <mxCell id="N3" value="Hantar &#8594; INSERT/UPDATE psy_kyc_submissions&#10;(status = pending) + &#128276; notify admin/doctor/manager&#10;+ notify patient &#183; redirect dashboard (akses BELUM dibuka)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="300" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="N4" value="Admin: kyc-list.html &#8594; kyc-review.html&#10;(semak jawapan + dokumen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="450" y="404" width="300" height="56" as="geometry" /></mxCell>
        <mxCell id="DEC" value="Lulus?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="530" y="500" width="140" height="90" as="geometry" /></mxCell>

        <!-- REJECT (kanan) -->
        <mxCell id="REJ" value="status = rejected + review_notes&#10;&#8594; &#128276; notify patient &#8594; kyc.html papar &#8220;Ditolak&#8221;&#10;(fillForm utk kemaskini)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="800" y="500" width="300" height="80" as="geometry" /></mxCell>

        <!-- APPROVE -->
        <mxCell id="APP" value="status = approved&#10;&#8594; &#128293; psy_patients.status = 'active' + salin data&#10;(+ psy_referrals jika ada rujukan) &#183; &#128276; notify patient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="640" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="GATE" value="&#128274; AKSES DIBUKA (GATE 1)&#10;KYC diluluskan &#8594; boleh Tempah KOB + features penuh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="750" width="340" height="60" as="geometry" /></mxCell>
        <mxCell id="NEXT" value="&#8594; Flow KOB" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="850" width="160" height="46" as="geometry" /></mxCell>

        <!-- EDGES -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="N1" target="N2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="N2" target="N3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="N3" target="N4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="N4" target="DEC"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="DEC" target="REJ"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="kemaskini &amp; hantar semula" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="REJ" target="N2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="Ya" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="DEC" target="APP"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="APP" target="GATE"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="GATE" target="NEXT"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="S1" target="S2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="auto-approved, skip KYC" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="S2" target="GATE"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
