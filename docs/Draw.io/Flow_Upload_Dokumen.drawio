<mxfile host="app.diagrams.net" agent="ISW" version="24.0.0">
  <diagram name="Flow Upload Dokumen" id="upload-dok">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <!-- TITLE + LEGEND -->
        <mxCell id="t" value="Flow Upload Dokumen (Rekod Perubatan) — dari Upload sampai Review &amp; Kongsi" style="text;html=1;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="980" height="28" as="geometry" /></mxCell>
        <mxCell id="lg" value="Patient=ungu &#183; Doctor=oren &#183; Sistem=hijau &#183; keputusan=putih &#183; storage=fail" style="text;html=1;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="700" height="16" as="geometry" /></mxCell>

        <!-- PATIENT UPLOAD -->
        <mxCell id="P1" value="Patient: rekod-perubatan.html &#8594; Tambah Rekod (rekod-tambah.html)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="60" width="360" height="46" as="geometry" /></mxCell>
        <mxCell id="P2" value="Pilih report_type (X-Ray &#183; MRI &#183; CT &#183; blood test &#183; dll)&#10;+ title + sample_date + nota" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="124" width="360" height="56" as="geometry" /></mxCell>
        <mxCell id="P3" value="Upload fail (PDF / imej &#183; boleh multiple)&#10;&#8594; storage &#8216;medical-reports&#8217;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="196" width="360" height="56" as="geometry" /></mxCell>
        <mxCell id="P4" value="INSERT psy_medical_reports&#10;(status = ready &#183; review_status = pending &#183; uploaded_by)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="415" y="268" width="370" height="56" as="geometry" /></mxCell>
        <mxCell id="PDEL" value="Patient boleh PADAM rekod&#10;selagi review_status = pending &amp; uploaded_by = self" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="272" width="330" height="56" as="geometry" /></mxCell>

        <!-- DOCTOR REVIEW -->
        <mxCell id="D1" value="Doctor: patient-hub &#8594; tab Laporan (lihat rekod)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="356" width="360" height="46" as="geometry" /></mxCell>
        <mxCell id="DUP" value="Doctor juga boleh &#8220;+ Upload&#8221; laporan sendiri&#10;(report_type &#183; summary &#183; categories) &#8594; INSERT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1"><mxGeometry x="840" y="350" width="320" height="58" as="geometry" /></mxCell>
        <mxCell id="D2" value="Semak fail + isi doctor_review&#10;&#8594; UPDATE review_status = reviewed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="415" y="418" width="370" height="50" as="geometry" /></mxCell>
        <mxCell id="DSH" value="Kongsi dengan&#10;patient?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="510" y="492" width="170" height="80" as="geometry" /></mxCell>
        <mxCell id="NS" value="Simpan (staff sahaja &#183; tak dikongsi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="820" y="502" width="280" height="50" as="geometry" /></mxCell>
        <mxCell id="SH" value="&#128293; review_status = reviewed + shared&#10;&#8594; patient nampak ulasan doktor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="415" y="600" width="370" height="56" as="geometry" /></mxCell>

        <!-- OUTPUT -->
        <mxCell id="O" value="Patient rekod-perubatan.html:&#10;senarai rekod + status (Pending / Reviewed)&#10;+ ulasan doktor (jika dikongsi) + muat turun fail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="415" y="690" width="370" height="76" as="geometry" /></mxCell>

        <!-- EDGES -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="P1" target="P2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="P2" target="P3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="P3" target="P4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="P4" target="PDEL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="P4" target="D1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="atau doctor upload" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="DUP" target="D1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="D1" target="D2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="D2" target="DSH"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="DSH" target="NS"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="Ya" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="DSH" target="SH"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="SH" target="O"><mxGeometry relative="1" as="geometry" /></mxCell>
