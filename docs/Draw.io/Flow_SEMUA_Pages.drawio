                </mxCell>
                <mxCell id="n1" value="START&#xa;Pesakit buka auth/login.html, klik tab DAFTAR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="120" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="Isi borang: Nama Penuh, Emel, Kata Laluan (min 6),&#xa;setuju Terma. Peranan = patient (tersembunyi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="195" width="320" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="auth.signUp(emel, kata laluan,&#xa;metadata: full_name + role=patient)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="275" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="d1" value="Emel sudah didaftar?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="440" y="350" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="r1" value="Ralat: &#39;Emel sudah didaftar —&#xa;log masuk / guna emel lain&#39;&#xa;(berhenti)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="60" y="365" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="🔥 Supabase cipta auth.users + hantar emel pengesahan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="465" width="320" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="🔥 TRIGGER handle_new_user&#xa;→ INSERT psy_profiles (role=patient, is_active=true)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="535" width="320" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="n7" value="🔥 TRIGGER handle_new_patient_profile&#xa;→ INSERT psy_patients (status=pending_kyc,&#xa;kob_status=paid, created_by_staff=false)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="615" width="320" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="n8" value="🔥 TRIGGER assign_patient_mrn → auto MRN (P-001 ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="705" width="320" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="n9" value="Skrin: &#39;Pendaftaran Berjaya!&#xa;Sila semak emel untuk pengesahan&#39;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="775" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="n10" value="Pesakit klik link emel → akaun disahkan → Log Masuk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="850" width="320" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="d2" value="Auto-link? Ada rekod staff (user_id NULL)&#xa;dengan emel sama?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="430" y="920" width="220" height="100" as="geometry"/>
