                <mxCell id="db3" value="psy_patients" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;boundedLbl=1;backgroundOutline=1;size=8;" parent="1" vertex="1">
                    <mxGeometry x="790" y="756" width="180" height="44" as="geometry"/>
