                    <mxGeometry x="790" y="290" width="400" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="notebox" value="NOTA PENTING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontStyle=1;fontSize=12;verticalAlign=top;align=center;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="770" y="350" width="440" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="note1" value="• Borang daftar minta Nama + Emel + Kata Laluan sahaja; IC &amp; telefon di borang KYC&#xa;• 3 trigger auto berjalan selepas signup (profiles, patients, MRN)&#xa;• kob_status bermula &#39;paid&#39; (bayaran luar via GHL)&#xa;• 2 lapis gate: GATE 1 = KYC lulus, GATE 2 = KOB selesai&#xa;• Auto-link: jika staff dah cipta rekod dengan emel sama, ia dipautkan automatik&#xa;• Pengesahan emel dikendalikan Supabase&#xa;• MRN auto format P-001, P-002 ...&#xa;• Semua tindakan direkod dalam audit log" style="text;html=1;align=left;fontSize=11;spacingLeft=8;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="784" y="378" width="412" height="262" as="geometry"/>
                </mxCell>
                <mxCell id="jadbox" value="JADUAL / DATA TERLIBAT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;verticalAlign=top;align=center;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="770" y="670" width="440" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="db1" value="auth.users" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;boundedLbl=1;backgroundOutline=1;size=8;" parent="1" vertex="1">
