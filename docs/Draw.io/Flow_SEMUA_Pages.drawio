                <!-- TITLE BANNER -->
                <mxCell id="banner" value="FLOW: ADMIN CIPTA AKAUN STAFF&#xa;Dari Super Admin/Admin daftar staff sehingga log masuk pertama" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2d4d;strokeColor=none;fontColor=#ffffff;fontSize=18;fontStyle=1;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
