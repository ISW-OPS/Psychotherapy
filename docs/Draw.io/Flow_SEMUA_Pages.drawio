                <mxCell id="db4" value="psy_kyc_submissions" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;boundedLbl=1;backgroundOutline=1;size=8;" parent="1" vertex="1">
