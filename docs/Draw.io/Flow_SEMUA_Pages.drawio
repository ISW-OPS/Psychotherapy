                <mxCell id="S2" value="Patient signup (emel sama)&#xa;→ autoLink claim → SKIP KYC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="60" y="210" width="260" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="N1" value="Patient: Dashboard “Langkah 1/3”&#xa;→ Buka kyc.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="460" y="100" width="280" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="N2" value="Isi Borang KYC (lengkap):&#xa;IC · biodata · telefon/alamat · marital/occupation&#xa;waris · masalah kesihatan · insurans (opt)&#xa;upload IC + dokumen · consent (data/health/…)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="440" y="180" width="320" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="N3" value="Hantar → INSERT/UPDATE psy_kyc_submissions&#xa;(status = pending) + 🔔 notify admin/doctor/manager&#xa;+ notify patient · redirect dashboard (akses BELUM dibuka)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="430" y="300" width="340" height="80" as="geometry"/>
                </mxCell>
