<mxfile host="app.diagrams.net" agent="ISW" version="24.0.0">
  <diagram name="Flow Pesakit Signup" id="isw-signup-flow">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE BANNER -->
        <mxCell id="banner" value="FLOW: PESAKIT DAFTAR AKAUN (SELF SIGN-UP)&#10;Dari daftar sendiri sehingga akses penuh dibuka (KYC + KOB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2d4d;strokeColor=none;fontColor=#ffffff;fontSize=18;fontStyle=1;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1170" height="70" as="geometry" /></mxCell>

        <!-- PETUNJUK -->
        <mxCell id="legbox" value="PETUNJUK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="770" y="120" width="440" height="210" as="geometry" /></mxCell>
        <mxCell id="lg1" value="Start / End" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="150" width="180" height="30" as="geometry" /></mxCell>
        <mxCell id="lg2" value="Proses / Action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="150" width="180" height="30" as="geometry" /></mxCell>
        <mxCell id="lg3" value="Keputusan / Decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="190" width="180" height="34" as="geometry" /></mxCell>
        <mxCell id="lg4" value="Proses Auto / Trigger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="192" width="180" height="30" as="geometry" /></mxCell>
        <mxCell id="lg5" value="Warning / Gate Disekat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="240" width="180" height="30" as="geometry" /></mxCell>
        <mxCell id="lg6" value="Database" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;boundedLbl=1;backgroundOutline=1;size=8;" vertex="1" parent="1"><mxGeometry x="1010" y="238" width="180" height="40" as="geometry" /></mxCell>
        <mxCell id="lg7" value="&#128274; gate akses &#183; &#128293; auto-trigger &#183; &#128276; notifikasi" style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="790" y="290" width="400" height="20" as="geometry" /></mxCell>

        <!-- NOTA PENTING -->
        <mxCell id="notebox" value="NOTA PENTING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontStyle=1;fontSize=12;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="770" y="350" width="440" height="300" as="geometry" /></mxCell>
        <mxCell id="note1" value="&#8226; Borang daftar minta Nama + Emel + Kata Laluan sahaja; IC &amp; telefon di borang KYC&#10;&#8226; 3 trigger auto berjalan selepas signup (profiles, patients, MRN)&#10;&#8226; kob_status bermula 'paid' (bayaran luar via GHL)&#10;&#8226; 2 lapis gate: GATE 1 = KYC lulus, GATE 2 = KOB selesai&#10;&#8226; Auto-link: jika staff dah cipta rekod dengan emel sama, ia dipautkan automatik&#10;&#8226; Pengesahan emel dikendalikan Supabase&#10;&#8226; MRN auto format P-001, P-002 ...&#10;&#8226; Semua tindakan direkod dalam audit log" style="text;html=1;align=left;fontSize=11;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="784" y="378" width="412" height="262" as="geometry" /></mxCell>

        <!-- JADUAL / DATA TERLIBAT -->
        <mxCell id="jadbox" value="JADUAL / DATA TERLIBAT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="770" y="670" width="440" height="200" as="geometry" /></mxCell>
        <mxCell id="db1" value="auth.users" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;boundedLbl=1;backgroundOutline=1;size=8;" vertex="1" parent="1"><mxGeometry x="790" y="700" width="180" height="44" as="geometry" /></mxCell>
        <mxCell id="db2" value="psy_profiles" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;boundedLbl=1;backgroundOutline=1;size=8;" vertex="1" parent="1"><mxGeometry x="1010" y="700" width="180" height="44" as="geometry" /></mxCell>
        <mxCell id="db3" value="psy_patients" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;boundedLbl=1;backgroundOutline=1;size=8;" vertex="1" parent="1"><mxGeometry x="790" y="756" width="180" height="44" as="geometry" /></mxCell>
        <mxCell id="db4" value="psy_kyc_submissions" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;boundedLbl=1;backgroundOutline=1;size=8;" vertex="1" parent="1"><mxGeometry x="1010" y="756" width="180" height="44" as="geometry" /></mxCell>
        <mxCell id="db5" value="psy_audit_log" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;boundedLbl=1;backgroundOutline=1;size=8;" vertex="1" parent="1"><mxGeometry x="790" y="812" width="180" height="44" as="geometry" /></mxCell>

        <!-- MAIN FLOW -->
        <mxCell id="n1" value="START&#10;Pesakit buka auth/login.html, klik tab DAFTAR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="n2" value="Isi borang: Nama Penuh, Emel, Kata Laluan (min 6),&#10;setuju Terma. Peranan = patient (tersembunyi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="195" width="320" height="55" as="geometry" /></mxCell>
        <mxCell id="n3" value="auth.signUp(emel, kata laluan,&#10;metadata: full_name + role=patient)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="275" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="d1" value="Emel sudah didaftar?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="350" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="r1" value="Ralat: 'Emel sudah didaftar &#8212;&#10;log masuk / guna emel lain'&#10;(berhenti)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="365" width="280" height="60" as="geometry" /></mxCell>

        <mxCell id="n5" value="&#128293; Supabase cipta auth.users + hantar emel pengesahan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="465" width="320" height="45" as="geometry" /></mxCell>
        <mxCell id="n6" value="&#128293; TRIGGER handle_new_user&#10;&#8594; INSERT psy_profiles (role=patient, is_active=true)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="535" width="320" height="55" as="geometry" /></mxCell>
        <mxCell id="n7" value="&#128293; TRIGGER handle_new_patient_profile&#10;&#8594; INSERT psy_patients (status=pending_kyc,&#10;kob_status=paid, created_by_staff=false)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="615" width="320" height="65" as="geometry" /></mxCell>
        <mxCell id="n8" value="&#128293; TRIGGER assign_patient_mrn &#8594; auto MRN (P-001 ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="705" width="320" height="45" as="geometry" /></mxCell>
        <mxCell id="n9" value="Skrin: 'Pendaftaran Berjaya!&#10;Sila semak emel untuk pengesahan'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="775" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="n10" value="Pesakit klik link emel &#8594; akaun disahkan &#8594; Log Masuk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="850" width="320" height="45" as="geometry" /></mxCell>

        <mxCell id="d2" value="Auto-link? Ada rekod staff (user_id NULL)&#10;dengan emel sama?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="920" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="n11" value="&#128293; Auto-pautkan rekod sedia ada:&#10;set user_id, status=active,&#10;kob_status ikut pakej" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="935" width="280" height="70" as="geometry" /></mxCell>

        <mxCell id="d3" value="GATE 1 &#8212; KYC diluluskan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1050" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="g1a" value="&#128274; Akses disekat. Hanya dashboard/profil/kyc.&#10;Redirect ke kyc.html &#8594; isi KYC&#10;&#8594; INSERT psy_kyc_submissions (pending)&#10;&#8594; staff Lulus / Tolak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1055" width="300" height="80" as="geometry" /></mxCell>

        <mxCell id="d4" value="GATE 2 &#8212; KOB selesai?&#10;(kob_status = completed atau na)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="1175" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="g2a" value="&#128274; Redirect ke kob.html&#10;(lengkapkan KOB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1190" width="280" height="55" as="geometry" /></mxCell>

        <mxCell id="n14" value="AKSES PENUH dibuka &#8594; dashboard pesakit&#10;(pakej, pelan, vitals, kepatuhan, kedai)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="1320" width="320" height="60" as="geometry" /></mxCell>

