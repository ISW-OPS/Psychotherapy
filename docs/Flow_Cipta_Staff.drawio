        <mxCell id="lg5" value="Warning / Error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="240" width="180" height="30" as="geometry" /></mxCell>
