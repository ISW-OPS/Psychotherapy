        <mxCell id="n6" value="&#128293; Sahkan pemanggil: role=staff dan staff_role IN&#10;(super_admin, admin, manager).&#10;super_admin TIDAK boleh di-assign via UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="610" width="320" height="65" as="geometry" /></mxCell>

