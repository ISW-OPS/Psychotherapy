        <mxCell id="lg7" value="&#128274; gate akses &#183; &#128293; auto-trigger &#183; &#128276; notifikasi" style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="790" y="290" width="400" height="20" as="geometry" /></mxCell>

        <!-- NOTA PENTING -->
        <mxCell id="notebox" value="NOTA PENTING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontStyle=1;fontSize=12;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="770" y="350" width="440" height="300" as="geometry" /></mxCell>
        <mxCell id="note1" value="&#8226; Hanya super_admin/admin/manager boleh cipta staff&#10;&#8226; Peranan: admin, doctor, coach, manager (super_admin set via SQL sahaja)&#10;&#8226; Cipta staff guna Edge Function 'invite-staff' (service role)&#10;&#8226; 2 cara aktif: Email Invite atau Set Kata Laluan sementara&#10;&#8226; RBAC: kebenaran = peranan default + override pengguna&#10;&#8226; Setiap cipta/edit/padam direkod dalam audit log" style="text;html=1;align=left;fontSize=11;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="784" y="378" width="412" height="262" as="geometry" /></mxCell>

        <!-- JADUAL / DATA TERLIBAT -->
        <mxCell id="jadbox" value="JADUAL / DATA TERLIBAT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="770" y="670" width="440" height="260" as="geometry" /></mxCell>
        <mxCell id="db1" value="auth.users" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;boundedLbl=1;backgroundOutline=1;size=8;" vertex="1" parent="1"><mxGeometry x="790" y="700" width="180" height="44" as="geometry" /></mxCell>
