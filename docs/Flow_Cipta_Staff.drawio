<mxfile host="app.diagrams.net" agent="ISW" version="24.0.0">
  <diagram name="Flow Cipta Staff" id="isw-cipta-staff-flow">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE BANNER -->
        <mxCell id="banner" value="FLOW: ADMIN CIPTA AKAUN STAFF&#10;Dari Super Admin/Admin daftar staff sehingga log masuk pertama" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2d4d;strokeColor=none;fontColor=#ffffff;fontSize=18;fontStyle=1;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1170" height="70" as="geometry" /></mxCell>

        <!-- PETUNJUK -->
        <mxCell id="legbox" value="PETUNJUK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="770" y="120" width="440" height="210" as="geometry" /></mxCell>
        <mxCell id="lg1" value="Start / End" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="150" width="180" height="30" as="geometry" /></mxCell>
