        <mxCell id="a1" value="&#128293; inviteUserByEmail()&#10;&#8594; Supabase hantar emel link&#10;set kata laluan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="280" height="65" as="geometry" /></mxCell>
