        <!-- LEGEND -->
        <mxCell id="leg1" value="Patient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="950" y="34" width="100" height="26" as="geometry" /></mxCell>
