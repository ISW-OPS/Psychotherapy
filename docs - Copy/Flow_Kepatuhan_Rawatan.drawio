        <mxCell id="OUT4" value="Coach Dashboard&#10;Ringkasan + Low Compliance + Alert Madu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="830" y="740" width="260" height="60" as="geometry" /></mxCell>

        <!-- NOTE -->
        <mxCell id="note" value="Nota: Gred A/B/C untuk klasifikasi rasmi; Tier 5-aras untuk paparan visual. Coach boleh override kelas mingguan (rowTier guna nilai wakil)." style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="700" height="20" as="geometry" /></mxCell>

