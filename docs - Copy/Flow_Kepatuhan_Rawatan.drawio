        <mxCell id="leg3" value="Sistem (auto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="950" y="66" width="100" height="26" as="geometry" /></mxCell>
        <mxCell id="leg4" value="&#128293; auto-kira" style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="66" width="150" height="20" as="geometry" /></mxCell>

        <!-- INPUTS -->
        <mxCell id="SRC1" value="Patient: Catatan Harian (harian)&#10;&#8594; psy_kepatuhan_log (skor_harian)&#10;(lihat Flow_Catatan_Harian)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="100" y="90" width="290" height="70" as="geometry" /></mxCell>
        <mxCell id="SRC2" value="Coach: plan-week.html &#8594; Kepatuhan Rawatan&#10;(madu sudu/hari &#183; nafas kali &#183; terapi bumi min &#183; kolon)&#10;&#8594; psy_plan_compliance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="710" y="86" width="320" height="78" as="geometry" /></mxCell>

        <!-- AGGREGATION -->
        <mxCell id="AGG" value="&#128293; Kira Purata Skor Mingguan (avg)&#10;Pilihan B: denominator = hari BERLALU dalam minggu&#10;(hujung minggu dicap pada hari ini)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="410" y="220" width="320" height="78" as="geometry" /></mxCell>

        <mxCell id="CLS" value="&#128293; classify(avg)&#10;A &#8805; 85 &#183; B &#8805; 50 &#183; C &lt; 50&#10;(CUT_A = 85, CUT_B = 50)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="280" height="70" as="geometry" /></mxCell>

        <mxCell id="DECOV" value="Coach override&#10;kelas?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="430" width="140" height="90" as="geometry" /></mxCell>
        <mxCell id="OVR" value="Coach set kelas manual (A/B/C)&#10;&#8594; tier (A=90, B=60, C=20)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="760" y="435" width="280" height="60" as="geometry" /></mxCell>

        <mxCell id="TIER" value="&#128293; tier5(score) &#8212; 5 aras paparan&#10;&#8805;85 Sangat Tinggi (Aktif &amp; Konsisten)&#10;&#8805;70 Tinggi (Aktif)&#10;&#8805;50 Sederhana (Tidak Konsisten)&#10;&#8805;30 Rendah (Perlu Ditingkatkan)&#10;&lt;30 Sangat Rendah (Tidak Aktif) &#183; null = Belum isi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="560" width="340" height="120" as="geometry" /></mxCell>

