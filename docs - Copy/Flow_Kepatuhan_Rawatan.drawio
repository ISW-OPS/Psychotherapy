  <diagram name="Flow Kepatuhan Rawatan" id="isw-kepatuhan-flow">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
